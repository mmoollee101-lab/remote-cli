# Telegram Bot Token (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 허용된 Telegram 유저 ID (봇에 /start 보내면 콘솔에 출력됨)
AUTHORIZED_USER_ID=your_user_id_here

# 컴퓨터 이름 (텔레그램에 표시됨, 여러 컴퓨터 구분용)
COMPUTER_NAME=내PC

# 헬스체크 URL (선택) — 장시간 접속 끊김 시 개발자 메일 알림용
# healthchecks.io 등에서 발급받은 ping URL을 넣으세요.
# 봇이 살아있고 텔레그램에 연결돼 있을 때만 주기적으로 ping을 보냅니다.
# ping이 설정한 기간 동안 끊기면 해당 서비스가 자동으로 메일을 발송합니다.
# (PC/인터넷이 완전히 죽어도 ping이 멈추므로 알림이 갑니다)
# 예: https://hc-ping.com/your-uuid-here
HEALTHCHECK_URL=
# 노트북 절전/종료 시 알림 자동 멈춤(오탐 방지)용 — healthchecks.io Settings의 API key(read-write)
HEALTHCHECK_API_KEY=

# ─── 이메일 (선택) — 원격 재시작 수신 + 이상 알림 발송 겸용 ──────
# Gmail 앱 비밀번호 필요: https://myaccount.google.com/apppasswords (2단계 인증 필수)
# 1) 원격 재시작: 위 계정 받은편지함에 제목 "LAWBOT RESTART"/"MAINBOT RESTART" 메일이
#    허용 발신자로부터 오면 재시작.
# 2) 이상 알림: 법률봇이 3분+ 다운되면 봇이 '재시작 링크 포함' 메일을 자동 발송.
RESTART_EMAIL_USER=
RESTART_EMAIL_PASS=
# 허용 발신자 주소(비우면 위 USER 주소만 허용). 예: mmoollee101@gmail.com
RESTART_EMAIL_FROM=
# 이상 알림 메일 수신 주소(비우면 RESTART_EMAIL_FROM → USER 순으로 사용)
ALERT_EMAIL_TO=

# ─── 웹 링크로 원격 재시작 (선택) ──────────────────────────────
# 값을 채우면 활성화. 시작 시 재시작 링크를 텔레그램으로 보내드립니다.
# 링크를 클릭하면(텔레그램이 죽어도) 봇이 재시작됩니다.
# 토큰은 아무나 못 누르게 하는 비밀키 — 길고 무작위로 정하세요.
RESTART_WEB_TOKEN=
# RESTART_WEB_PORT=18925
